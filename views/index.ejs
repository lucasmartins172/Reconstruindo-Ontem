<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Reconstruindo Ontem</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500&family=Lora:ital,wght@0,500;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/stylesheets/style.css" />
</head>
<body>
  <header class="topbar">
    <div class="container topbar-inner">
      <div class="brand">
        <span class="brand-icon" aria-hidden="true">🕯️</span>
        <div>
          <h1>Reconstruindo Ontem</h1>
        </div>
      </div>
    </div>
  </header>

  <main class="container main-layout">
    <!-- Coluna do Formulário (INSERIR e ALTERAR) -->
    <aside class="form-column">
      <section class="card form-card" id="form-card" aria-labelledby="form-title">
        <div class="card-header">
          <div>
            <span class="badge-pk" id="next-quant-badge" data-proximo-id="<%= proximoId %>">
              Lembrança #<%= proximoId %>
            </span>
            <h2 id="form-title">Inserir Lembrança</h2>
          </div>
        </div>

        <form id="lembranca-form" action="/itens" method="POST">
          <!-- Campo: Nome -->
          <div class="form-group">
            <div class="label-row">
              <label for="nome">Nome</label>
              <span class="char-counter" id="nome-counter">0 / 80</span>
            </div>
            <input
              type="text"
              id="nome"
              name="Nome"
              maxlength="80"
              placeholder="Ex.: Tarde na casa da vó"
              required
            />
            <small class="field-error" id="nome-error"></small>
          </div>

          <!-- Campo: Descrição -->
          <div class="form-group">
            <div class="label-row">
              <label for="descricao">Descrição</label>
              <span class="char-counter" id="descricao-counter">0 / 500</span>
            </div>
            <textarea
              id="descricao"
              name="Descricao"
              maxlength="500"
              rows="4"
              placeholder="Escreva os detalhes, cheiros, sons ou sentimentos desse momento..."
              required
            ></textarea>
            <small class="field-error" id="descricao-error"></small>
          </div>

          <!-- Campos: Data e Hora -->
          <div class="form-row-2">
            <div class="form-group">
              <label for="data-escrita">Data</label>
              <input type="date" id="data-escrita" name="Data_Escrita" required />
              <small class="field-error" id="data-error"></small>
            </div>

            <div class="form-group">
              <label for="hora-escrita">Hora</label>
              <input type="time" id="hora-escrita" name="Hora_Escrita" step="1" required />
              <small class="field-error" id="hora-error"></small>
            </div>
          </div>

          <!-- Botões de Ação -->
          <div class="form-actions-grid">
            <button type="button" class="btn-ghost" id="btn-agora" title="Preencher com data e hora atuais">
              ↻ Agora
            </button>

            <button type="submit" class="btn-primary" id="btn-inserir">
              + Inserir
            </button>

            <button type="submit" class="btn-warning" id="btn-salvar-alteracao" hidden>
              ✓ Salvar Alteração
            </button>

            <button type="button" class="btn-ghost" id="btn-cancelar-edicao" hidden>
              Cancelar
            </button>
          </div>
        </form>
      </section>
    </aside>

    <!-- Coluna de Exibição -->
    <section class="content-column">
      <% if (erro) { %>
        <div class="alert-error"><%= erro %></div>
      <% } %>

      <!-- Barra de Pesquisa -->
      <form class="search-toolbar" id="search-form" action="/itens" method="GET" role="search">
        <div class="search-input-wrap">
          <input
            type="search"
            id="busca-input"
            name="q"
            value="<%= termoBusca %>"
            placeholder="Pesquisar por lembrança (#), nome ou descrição..."
            aria-label="Pesquisar lembranças"
          />
        </div>
        <button type="submit" class="btn-search" id="btn-pesquisar">
          🔍 Pesquisar
        </button>
        <a href="/" class="btn-ghost btn-link" id="btn-limpar-pesquisa" <%= termoBusca ? '' : 'hidden' %>>
          Limpar
        </a>
        <span class="total-badge" id="total-registros">
          <%= lembrancas.length %> <%= lembrancas.length === 1 ? 'registro' : 'registros' %>
        </span>
      </form>

      <!-- Mural de Cards -->
      <div id="lembrancas-grid" class="lembrancas-grid">
        <% if (lembrancas.length === 0) { %>
          <div class="empty-state">
            <p>Nenhuma lembrança encontrada<%= termoBusca ? ` para "${termoBusca}"` : '' %>.</p>
            <small>Preencha o formulário ao lado e clique em <strong>+ Inserir</strong>.</small>
          </div>
        <% } else { %>
          <% lembrancas.forEach((item) => { 
               const partesData = String(item.Data_Escrita).split('-');
               const dataBR = partesData.length === 3 ? `${partesData[2]}/${partesData[1]}/${partesData[0]}` : item.Data_Escrita;
          %>
            <article
              class="memory-card"
              data-id="<%= item.id %>"
              data-nome="<%= item.Nome.toLowerCase() %>"
              data-descricao="<%= item.Descricao.toLowerCase() %>"
            >
              <div>
                <div class="memory-top">
                  <span class="memory-id">Lembrança #<%= item.id %></span>
                  <span class="memory-datetime"><%= dataBR %> às <%= item.Hora_Escrita %></span>
                </div>
                <h3 class="memory-title"><%= item.Nome %></h3>
                <p class="memory-desc"><%= item.Descricao %></p>
              </div>
              <div class="memory-footer">
                <div class="memory-crud-actions">
                  <button
                    type="button"
                    class="btn-card-action btn-card-edit btn-alterar"
                    data-id="<%= item.id %>"
                    data-nome="<%= item.Nome %>"
                    data-descricao="<%= item.Descricao %>"
                    data-data="<%= item.Data_Escrita %>"
                    data-hora="<%= item.Hora_Escrita %>"
                  >
                    ✎ Alterar
                  </button>
                  <button
                    type="button"
                    class="btn-card-action btn-card-delete btn-excluir"
                    data-id="<%= item.id %>"
                    data-nome="<%= item.Nome %>"
                  >
                    🗑 Excluir
                  </button>
                </div>
              </div>
            </article>
          <% }) %>
        <% } %>
      </div>

      <!-- Tabela HTML com os dados cadastrados (requisito do PDF) -->
      <div class="card table-card">
        <div class="card-header">
          <h3>Registros Cadastrados</h3>
        </div>
        <div class="table-wrapper">
          <table class="sql-table">
            <thead>
              <tr>
                <th>Lembrança</th>
                <th>Nome</th>
                <th>Descrição</th>
                <th>Data</th>
                <th>Hora</th>
              </tr>
            </thead>
            <tbody id="tabela-lembrancas-body">
              <% if (lembrancas.length === 0) { %>
                <tr>
                  <td colspan="5" style="text-align:center; color: var(--text-muted);">
                    Nenhum registro cadastrado.
                  </td>
                </tr>
              <% } else { %>
                <% lembrancas.forEach((item) => { 
                     const partesData = String(item.Data_Escrita).split('-');
                     const dataBR = partesData.length === 3 ? `${partesData[2]}/${partesData[1]}/${partesData[0]}` : item.Data_Escrita;
                %>
                  <tr
                    data-id="<%= item.id %>"
                    data-nome="<%= item.Nome.toLowerCase() %>"
                    data-descricao="<%= item.Descricao.toLowerCase() %>"
                  >
                    <td>Lembrança #<%= item.id %></td>
                    <td><%= item.Nome %></td>
                    <td><%= item.Descricao %></td>
                    <td><%= dataBR %></td>
                    <td><%= item.Hora_Escrita %></td>
                  </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </main>

  <!-- Modal de Confirmação de Exclusão -->
  <div class="modal-backdrop" id="delete-modal" hidden>
    <div class="modal-card modal-sm" role="dialog" aria-modal="true" aria-labelledby="delete-modal-title">
      <div class="modal-header">
        <h3 id="delete-modal-title">Excluir Lembrança?</h3>
        <button type="button" class="btn-close" id="btn-fechar-delete" aria-label="Fechar">&times;</button>
      </div>
      <p class="delete-msg" id="delete-modal-msg">Tem certeza que deseja excluir este registro?</p>
      <form id="delete-form" method="POST" class="modal-footer gap-sm">
        <button type="button" class="btn-ghost" id="btn-cancelar-delete">Cancelar</button>
        <button type="submit" class="btn-danger">Confirmar Exclusão</button>
      </form>
    </div>
  </div>

  <script src="/javascripts/script.js"></script>
</body>
</html>
